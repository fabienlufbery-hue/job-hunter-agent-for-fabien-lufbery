# ==============================================================================
# Job Hunter Agent for Fabien Lufbery — Environment Configuration Template
# Copy this file to .env.local for local development. NEVER commit .env.local.
# ==============================================================================

# --- Application & Public URL ---
NEXT_PUBLIC_APP_NAME="Job Hunter Agent for Fabien Lufbery"
NEXT_PUBLIC_APP_URL="https://job-hunter-agent-for-fabien-lufbery.vercel.app"

# --- Security & Personal Dashboard Authentication ---
# Generate strong random 32+ byte hex strings: openssl rand -hex 32
AUTH_SECRET="replace-with-64-char-random-hex-secret"
ADMIN_EMAIL="fabien.lufbery@example.com"
# Use ADMIN_PASSWORD locally or provision a scrypt ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD_HASH=""
ADMIN_PASSWORD="replace-with-strong-personal-password"

# --- Automation & Cron Security ---
# Token used by GitHub Actions (09:00 & 18:00 Europe/Paris) to authenticate POST /api/cron/sync
CRON_SECRET="replace-with-random-cron-secret"

# --- PostgreSQL Database (Required in Production on Vercel: Neon) ---
# Example Neon: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Leave empty ONLY in local development to use embedded local PostgreSQL (PGlite in ./.data/pglite)
DATABASE_URL=""

# --- Google Gemini API ---
# Official SDK: @google/genai
# Verified stable models (Nov 2026): gemini-3.5-flash-lite (default, low-cost) or gemini-3.8-flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# --- Apify API v2 ---
# Token from https://console.apify.com/settings/integrations (server-side only)
APIFY_API_TOKEN=""
# Optional default Apify Task ID (e.g. username~my-jobs-task). Additional Actors & Tasks
# can be selected and configured directly in the Settings UI.
APIFY_TASK_ID=""
# Optional default Apify Actor IDs (comma-separated) or webhook secret
APIFY_WEBHOOK_SECRET=""
