{
  "manifest_version": 3,
  "name": "Job Hunter Agent for Fabien Lufbery",
  "short_name": "Job Hunter FL",
  "version": "1.0.0",
  "description": "Collecte autorisée d'offres d'emploi (Welcome to the Jungle, Indeed, HelloWork, Meteojob) et synchronisation sécurisée pour Job Hunter Agent for Fabien Lufbery.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://www.welcometothejungle.com/*",
    "https://fr.indeed.com/*",
    "https://www.indeed.com/*",
    "https://www.hellowork.com/*",
    "https://www.meteojob.com/*",
    "http://localhost:3000/*",
    "https://job-hunter-agent-for-fabien-lufbery.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Job Hunter Agent for Fabien Lufbery",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.welcometothejungle.com/*",
        "https://fr.indeed.com/*",
        "https://www.indeed.com/*",
        "https://www.hellowork.com/*",
        "https://www.meteojob.com/*"
      ],
      "js": [
        "extractors/common.js",
        "extractors/wttj.js",
        "extractors/indeed.js",
        "extractors/hellowork.js",
        "extractors/meteojob.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "102"
}
